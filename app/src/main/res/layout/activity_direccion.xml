<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2FF">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/deliveat"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- DIRECCION -->
    <EditText
        android:id="@+id/etDireccion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Dirección"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="24dp"/>

    <!-- REFERENCIA -->
    <EditText
        android:id="@+id/etReferencia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Referencia"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/etDireccion"
        app:layout_constraintStart_toStartOf="@id/etDireccion"
        app:layout_constraintEnd_toEndOf="@id/etDireccion"
        android:layout_marginTop="12dp"/>

    <!-- CIUDAD -->
    <EditText
        android:id="@+id/etCiudad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Ciudad"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/etReferencia"
        app:layout_constraintStart_toStartOf="@id/etDireccion"
        app:layout_constraintEnd_toEndOf="@id/etDireccion"
        android:layout_marginTop="12dp"/>

    <!-- DISTRITO -->
    <EditText
        android:id="@+id/etDistrito"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Distrito"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/etCiudad"
        app:layout_constraintStart_toStartOf="@id/etDireccion"
        app:layout_constraintEnd_toEndOf="@id/etDireccion"
        android:layout_marginTop="12dp"/>

    <!-- BOTON DE REGISTRAR -->
    <Button
        android:id="@+id/btnGuardarDireccion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Guardar dirección"
        android:textAllCaps="false"
        android:backgroundTint="#6A4BC3"
        android:textColor="@android:color/white"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/etDistrito"
        app:layout_constraintStart_toStartOf="@id/etDireccion"
        app:layout_constraintEnd_toEndOf="@id/etDireccion"
        android:layout_marginTop="24dp"/>

    <Button
        android:id="@+id/btnOmitir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Omitir por ahora"
        android:textAllCaps="false"
        android:backgroundTint="#B0B0B0"
        android:textColor="@android:color/white"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnGuardarDireccion"
        app:layout_constraintStart_toStartOf="@id/btnGuardarDireccion"
        app:layout_constraintEnd_toEndOf="@id/btnGuardarDireccion"/>

</androidx.constraintlayout.widget.ConstraintLayout>
